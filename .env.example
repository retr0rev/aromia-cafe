# Aromia Cafe Menu — Environment Variables
# Copy this file to .env and fill in your values.
# All variables are REQUIRED — the server will not start without them.

# JWT secret for signing admin tokens
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Admin credentials (used to create the admin account on first run)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Server port (optional, defaults to 3001)
# PORT=3001

# CORS origin for production (optional, defaults to same-origin)
# CORS_ORIGIN=https://your-domain.com
